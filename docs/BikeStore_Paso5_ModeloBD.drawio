1" source="c14" target="c103"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c211" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#444444;startFill=0;endFill=0;startArrow=ERmandOne;endArrow=ERzeroToMany;startSize=14;endSize=14;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c155" target="c56"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c212" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#444444;startFill=0;endFill=0;startArrow=ERmandOne;endArrow=ERoneToMany;startSize=14;endSize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c103" target="c129"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c213" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#444444;startFill=0;endFill=0;startArrow=ERmandOne;endArrow=ERzeroToMany;startSize=14;endSize=14;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c155" target="c129"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c214" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#444444;startFill=0;endFill=0;startArrow=ERmandOne;endArrow=ERmandOne;startSize=14;endSize=14;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c103" target="c77"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c215" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#444444;startFill=0;endFill=0;startArrow=ERmandOne;endArrow=ERzeroToMany;startSize=14;endSize=14;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c196" target="c155"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c216" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Columnas de cada tabla: llave (PK / FK) · nombre del campo · tipo de dato · longitud.&lt;br&gt;PK = llave primaria (campo subrayado). FK = llave foránea: apunta a la llave primaria de otra tabla; la tabla que la contiene es la tabla dependiente.&lt;br&gt;Cardinalidad (notación pata de gallo): el símbolo junto a una tabla indica cuántos registros de esa tabla se relacionan con un registro de la otra.&lt;br&gt;Símbolos usados: uno y solo uno · cero o uno · uno o muchos · cero o muchos.&lt;br&gt;Tablas independientes: ROL y CATEGORIA. El resto son tablas dependientes.&lt;br&gt;El total del pedido no se guarda: se calcula con la suma de cantidad × precio_unitario de sus detalles.&lt;br&gt;Tipos de dato: propuesta para PostgreSQL." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="820" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>